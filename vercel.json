{
  "functions": {
    "api/papers.js": {
      "includeFiles": "data/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jupeb-question-bank-test.vercel.app"
        }
      ],
      "destination": "https://test.jupebijmbprep.com/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "jupeb-question-bank.vercel.app"
        }
      ],
      "destination": "https://jupebijmbprep.com/$1",
      "permanent": false
    },
    {
      "source": "/data/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://jupeb-question-bank.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://jupeb-question-bank.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!data/|api/|images/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
